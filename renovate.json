{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "github>christianpflugradt/repository-catalog:renovate-governor",
    "github>christianpflugradt/repository-catalog:renovate-content-aware",
    ":maintainLockFilesMonthly"
  ],
  "platformAutomerge": false,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "!please-behave/cli",
        "!please-behave/action"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "!please-behave/action"
      ]
    },
    {
      "description": "Updates that cannot change the released jar use ci so they do not trigger a release.",
      "matchManagers": ["github-actions", "gradle-wrapper", "mise", "npm", "custom.regex"],
      "semanticCommitType": "ci"
    }
  ]
}
